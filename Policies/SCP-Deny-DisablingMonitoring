// SCP: Deny-DisableMonitoring — attach to Production OU
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDisableSSMAgent",
      "Effect": "Deny",
      "Action": [
        "ssm:DeregisterManagedInstance",
        "ssm:DeleteAssociation"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/StackSet-DiskMonitoring-*"
        }
      }
    },
    {
      "Sid": "DenyDeleteOAMLink",
      "Effect": "Deny",
      "Action": "oam:DeleteLink",
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/StackSet-DiskMonitoring-*"
        }
      }
    },
    {
      "Sid": "DenyModifyMonitoringRole",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRole",
        "iam:DetachRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/DiskMonitoringEC2Role",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/StackSet-DiskMonitoring-*"
        }
      }
    }
  ]
}
